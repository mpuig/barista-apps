{
  "schema_version": "v1alpha1",
  "name": "factory",
  "version": "0.1.0",
  "description": "Durable coordinator/worker fan-out app driven only through the Host API.",
  "workload": {
    "image": "ghcr.io/mpuig/barista-factory:0.1.0",
    "digest": "sha256:5f0f2b8c1d3e4a5b6c7d8e9f00112233445566778899aabbccddeeff00112233",
    "architectures": [
      "aarch64",
      "x86_64"
    ],
    "entrypoint": [
      "/usr/local/bin/barista-factory",
      "run"
    ],
    "working_dir": "/work",
    "readiness": {
      "type": "log_line",
      "log_pattern": "coordinator ready",
      "timeout_seconds": 30
    }
  },
  "capabilities": {
    "optional": [
      {
        "capability": "grants.delegated"
      },
      {
        "capability": "session.fork"
      }
    ]
  },
  "permissions": {
    "actions": [
      "session.create",
      {
        "action": "session.get",
        "scope": "own_session"
      },
      {
        "action": "session.get",
        "scope": "created_sessions"
      },
      {
        "action": "session.list",
        "scope": "created_sessions"
      },
      {
        "action": "session.delete",
        "scope": "created_sessions"
      },
      {
        "action": "session.exec",
        "scope": "created_sessions"
      },
      {
        "action": "session.events",
        "scope": "created_sessions"
      },
      {
        "action": "artifact.read",
        "scope": "own_session"
      },
      {
        "action": "artifact.read",
        "scope": "created_sessions"
      },
      {
        "action": "artifact.write",
        "scope": "own_session"
      },
      {
        "action": "artifact.write",
        "scope": "created_sessions"
      }
    ],
    "network": {
      "egress": "allowlist",
      "allow": [
        "ntfy.sh:443"
      ]
    },
    "secrets": [
      {
        "name": "BARISTA_HOST_API_TOKEN",
        "ref": "grant://factory/coordinator"
      },
      {
        "name": "NOTIFY_TOKEN",
        "ref": "secret://factory/notify-token"
      }
    ],
    "artifacts": {
      "read": true,
      "write": true
    },
    "child_sessions": {
      "max_concurrent": 16,
      "max_total": 256,
      "allow_descendants": false,
      "actions": [
        {
          "action": "session.exec",
          "scope": "own_session"
        },
        {
          "action": "session.events",
          "scope": "own_session"
        },
        {
          "action": "artifact.write",
          "scope": "own_session"
        }
      ]
    }
  },
  "metadata": {
    "sh.barista.factory": {
      "mission_schema": "barista_app_factory/mission.schema.json"
    }
  }
}
