{
  "schema_version": "v1alpha1",
  "name": "factory",
  "version": "0.1.0",
  "description": "Durable coordinator/worker fan-out app driven only through the Host API.",
  "workload": {
    "image": "ghcr.io/mpuig/barista-factory:0.1.0",
    "digest": "sha256:5f0f2b8c1d3e4a5b6c7d8e9f00112233445566778899aabbccddeeff00112233",
    "architectures": [
      "aarch64",
      "x86_64"
    ],
    "entrypoint": [
      "/usr/local/bin/barista-factory",
      "run"
    ],
    "working_dir": "/work",
    "readiness": {
      "type": "log_line",
      "log_pattern": "coordinator ready",
      "timeout_seconds": 30
    }
  },
  "runs": {
    "mission": {
      "description": "Run a validated Factory mission to a terminal result.",
      "lifecycle": "coordinator",
      "input": {
        "media_type": "application/vnd.barista.factory.mission+json"
      },
      "outputs": {
        "result": {
          "kinds": [
            "sh.barista.artifact"
          ],
          "required": true
        }
      }
    },
    "software-change": {
      "description": "Fan a bounded software objective across isolated workers, integrate patches, independently check, and optionally deliver a draft pull request.",
      "lifecycle": "coordinator",
      "input": {
        "media_type": "application/json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker_app",
            "tasks",
            "acceptance"
          ],
          "properties": {
            "worker_app": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 80
            },
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "command"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "maxLength": 40
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  }
                }
              }
            },
            "acceptance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "files": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                }
              }
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "workspace_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "patch_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$",
              "maxLength": 200
            },
            "commit_message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "maxLength": 65536
            }
          }
        }
      },
      "bindings": {
        "workspace": {
          "kinds": [
            "sh.barista.git.repository"
          ],
          "required": true
        },
        "objective": {
          "kinds": [
            "sh.barista.text",
            "sh.barista.specification",
            "com.github.issue"
          ],
          "required": true
        }
      },
      "outputs": {
        "patch": {
          "kinds": [
            "sh.barista.git.patch"
          ],
          "required": true
        },
        "branch": {
          "kinds": [
            "sh.barista.git.branch"
          ],
          "required": false
        },
        "change": {
          "kinds": [
            "com.github.draft-pull-request"
          ],
          "required": false
        }
      },
      "deliveries": {
        "change": {
          "kinds": [
            "com.github.draft-pull-request"
          ]
        }
      }
    },
    "issue-sdlc": {
      "description": "Triage a GitHub issue in an isolated child, request clarification when needed, or implement and independently verify a draft candidate.",
      "lifecycle": "coordinator",
      "input": {
        "media_type": "application/json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triage_app",
            "triage",
            "attempt",
            "worker_app",
            "tasks",
            "acceptance"
          ],
          "properties": {
            "worker_app": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 80
            },
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "command"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "maxLength": 40
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    }
                  }
                }
              }
            },
            "acceptance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "files": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                }
              }
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "workspace_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "patch_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$",
              "maxLength": 200
            },
            "commit_message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "maxLength": 65536
            },
            "triage_app": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 80
            },
            "triage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                }
              }
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "answers": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "comment_id",
                  "body"
                ],
                "properties": {
                  "comment_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  "prior_result_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "bindings": {
        "workspace": {
          "kinds": [
            "sh.barista.git.repository"
          ],
          "required": true
        },
        "objective": {
          "kinds": [
            "com.github.issue"
          ],
          "required": true
        }
      },
      "outputs": {
        "patch": {
          "kinds": [
            "sh.barista.git.patch"
          ],
          "required": false
        },
        "branch": {
          "kinds": [
            "sh.barista.git.branch"
          ],
          "required": false
        },
        "change": {
          "kinds": [
            "com.github.draft-pull-request"
          ],
          "required": false
        },
        "question": {
          "kinds": [
            "com.github.issue-question"
          ],
          "required": false
        }
      },
      "deliveries": {
        "change": {
          "kinds": [
            "com.github.draft-pull-request"
          ]
        },
        "question": {
          "kinds": [
            "com.github.issue-comment"
          ]
        }
      }
    }
  },
  "capabilities": {
    "optional": [
      {
        "capability": "grants.delegated"
      },
      {
        "capability": "session.fork"
      }
    ]
  },
  "permissions": {
    "actions": [
      "session.create",
      {
        "action": "session.get",
        "scope": "own_session"
      },
      {
        "action": "session.get",
        "scope": "created_sessions"
      },
      {
        "action": "session.list",
        "scope": "created_sessions"
      },
      {
        "action": "session.delete",
        "scope": "created_sessions"
      },
      {
        "action": "session.exec",
        "scope": "created_sessions"
      },
      {
        "action": "session.events",
        "scope": "created_sessions"
      },
      {
        "action": "artifact.read",
        "scope": "own_session"
      },
      {
        "action": "artifact.read",
        "scope": "created_sessions"
      },
      {
        "action": "artifact.write",
        "scope": "own_session"
      },
      {
        "action": "artifact.write",
        "scope": "created_sessions"
      }
    ],
    "network": {
      "egress": "allowlist",
      "allow": [
        "ntfy.sh:443",
        "github.com:443",
        "api.github.com:443"
      ]
    },
    "secrets": [
      {
        "name": "BARISTA_HOST_API_TOKEN",
        "ref": "grant://factory/coordinator"
      },
      {
        "name": "NOTIFY_TOKEN",
        "ref": "secret://factory/notify-token"
      },
      {
        "name": "GITHUB_TOKEN",
        "ref": "secret://factory/github-token"
      }
    ],
    "artifacts": {
      "read": true,
      "write": true
    },
    "child_sessions": {
      "max_concurrent": 16,
      "max_total": 256,
      "allow_descendants": false,
      "actions": [
        {
          "action": "session.exec",
          "scope": "own_session"
        },
        {
          "action": "session.events",
          "scope": "own_session"
        },
        {
          "action": "artifact.write",
          "scope": "own_session"
        }
      ]
    }
  },
  "metadata": {
    "sh.barista.factory": {
      "mission_schema": "barista_app_factory/mission.schema.json"
    }
  }
}
