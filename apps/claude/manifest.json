{
  "schema_version": "v1alpha1",
  "name": "claude",
  "version": "2.1.251",
  "description": "Claude Code as a portable Barista app.",
  "workload": {
    "image": "ghcr.io/mpuig/barista-claude:2.1.251",
    "digest": "sha256:7088e81617f0243f8718449240d12439261c588904ddf8ecff1603e8fc929328",
    "architectures": ["aarch64", "x86_64"],
    "entrypoint": ["/usr/bin/sleep", "infinity"],
    "working_dir": "/work",
    "readiness": { "type": "none" }
  },
  "capabilities": {
    "optional": [
      { "capability": "session.snapshot.exact" }
    ]
  },
  "permissions": {
    "actions": ["session.exec", "session.events", "artifact.write"],
    "secrets": [
      { "name": "ANTHROPIC_API_KEY", "ref": "secret://anthropic/api-key" }
    ],
    "artifacts": { "write": true }
  },
  "state_transfer": {
    "semantic": {
      "adapter": "sh.barista.adapter.claude"
    }
  },
  "metadata": {
    "sh.barista.adapter.claude": {
      "supported_transcript_versions": [1],
      "native_media_type": "application/vnd.claude-code.transcript+jsonl"
    }
  }
}
