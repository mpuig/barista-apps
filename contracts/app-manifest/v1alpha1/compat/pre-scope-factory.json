{
  "schema_version": "v1alpha1",
  "name": "factory",
  "version": "0.1.0",
  "description": "Durable coordinator/worker fan-out app driven only through the Host API.",
  "workload": {
    "image": "ghcr.io/mpuig/barista-factory:0.1.0",
    "digest": "sha256:5f0f2b8c1d3e4a5b6c7d8e9f00112233445566778899aabbccddeeff00112233",
    "architectures": ["aarch64", "x86_64"],
    "entrypoint": ["/usr/local/bin/barista-factory", "run", "/work/mission.json"],
    "working_dir": "/work",
    "readiness": { "type": "log_line", "log_pattern": "coordinator ready", "timeout_seconds": 30 }
  },
  "capabilities": {
    "optional": [
      { "capability": "grants.delegated" },
      { "capability": "session.fork" }
    ]
  },
  "permissions": {
    "actions": [
      "session.create",
      "session.get",
      "session.list",
      "session.delete",
      "session.exec",
      "session.events",
      "artifact.read",
      "artifact.write"
    ],
    "network": { "egress": "allowlist", "allow": ["ntfy.sh:443"] },
    "secrets": [
      { "name": "NOTIFY_TOKEN", "ref": "secret://factory/notify-token" }
    ],
    "artifacts": { "read": true, "write": true },
    "child_sessions": { "max_concurrent": 16, "max_total": 256 }
  },
  "metadata": {
    "sh.barista.factory": {
      "mission_schema": "mission.schema.json"
    }
  }
}
